diff --git a/util/portable_sort.hpp b/util/portable_sort.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..d254d5595b93ec43e23c13b0c35d4477fda9977d
--- /dev/null
+++ b/util/portable_sort.hpp
@@ -0,0 +1,220 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Introsort with the same pivot selection, partitioning, thresholds and heap
+ * fallback as libstdc++'s std::sort. std::sort is not stable, and standard
+ * libraries order equal elements differently. Using one algorithm everywhere
+ * keeps codegen identical regardless of which C++ standard library dxil-spirv
+ * is built against.
+ */
+
+#pragma once
+
+#include <algorithm>
+#include <iterator>
+#include <stddef.h>
+#include <utility>
+
+namespace dxil_spv
+{
+namespace portable_sort_detail
+{
+enum { threshold = 16 };
+
+template <typename It, typename Value, typename Compare>
+void sort_push_heap(It first, ptrdiff_t hole, ptrdiff_t top, Value value, Compare &comp)
+{
+	ptrdiff_t parent = (hole - 1) / 2;
+	while (hole > top && comp(*(first + parent), value))
+	{
+		*(first + hole) = std::move(*(first + parent));
+		hole = parent;
+		parent = (hole - 1) / 2;
+	}
+	*(first + hole) = std::move(value);
+}
+
+template <typename It, typename Value, typename Compare>
+void sort_adjust_heap(It first, ptrdiff_t hole, ptrdiff_t len, Value value, Compare &comp)
+{
+	const ptrdiff_t top = hole;
+	ptrdiff_t child = hole;
+	while (child < (len - 1) / 2)
+	{
+		child = 2 * (child + 1);
+		if (comp(*(first + child), *(first + (child - 1))))
+			child--;
+		*(first + hole) = std::move(*(first + child));
+		hole = child;
+	}
+	if ((len & 1) == 0 && child == (len - 2) / 2)
+	{
+		child = 2 * (child + 1);
+		*(first + hole) = std::move(*(first + (child - 1)));
+		hole = child - 1;
+	}
+	sort_push_heap(first, hole, top, std::move(value), comp);
+}
+
+template <typename It, typename Compare>
+void sort_pop_heap(It first, It last, It result, Compare &comp)
+{
+	auto value = std::move(*result);
+	*result = std::move(*first);
+	sort_adjust_heap(first, 0, last - first, std::move(value), comp);
+}
+
+template <typename It, typename Compare>
+void sort_make_heap(It first, It last, Compare &comp)
+{
+	const ptrdiff_t len = last - first;
+	if (len < 2)
+		return;
+	ptrdiff_t parent = (len - 2) / 2;
+	for (;;)
+	{
+		auto value = std::move(*(first + parent));
+		sort_adjust_heap(first, parent, len, std::move(value), comp);
+		if (parent == 0)
+			return;
+		parent--;
+	}
+}
+
+template <typename It, typename Compare>
+void sort_heap_sort(It first, It last, Compare &comp)
+{
+	sort_make_heap(first, last, comp);
+	while (last - first > 1)
+	{
+		--last;
+		sort_pop_heap(first, last, last, comp);
+	}
+}
+
+template <typename It, typename Compare>
+void sort_move_median_to_first(It result, It a, It b, It c, Compare &comp)
+{
+	using std::iter_swap;
+	if (comp(*a, *b))
+	{
+		if (comp(*b, *c))
+			iter_swap(result, b);
+		else if (comp(*a, *c))
+			iter_swap(result, c);
+		else
+			iter_swap(result, a);
+	}
+	else if (comp(*a, *c))
+		iter_swap(result, a);
+	else if (comp(*b, *c))
+		iter_swap(result, c);
+	else
+		iter_swap(result, b);
+}
+
+template <typename It, typename Compare>
+It sort_unguarded_partition(It first, It last, It pivot, Compare &comp)
+{
+	for (;;)
+	{
+		while (comp(*first, *pivot))
+			++first;
+		--last;
+		while (comp(*pivot, *last))
+			--last;
+		if (!(first < last))
+			return first;
+		std::iter_swap(first, last);
+		++first;
+	}
+}
+
+template <typename It, typename Compare>
+void sort_introsort_loop(It first, It last, int depth_limit, Compare &comp)
+{
+	while (last - first > ptrdiff_t(threshold))
+	{
+		if (depth_limit == 0)
+		{
+			sort_heap_sort(first, last, comp);
+			return;
+		}
+		--depth_limit;
+		It mid = first + (last - first) / 2;
+		sort_move_median_to_first(first, first + 1, mid, last - 1, comp);
+		It cut = sort_unguarded_partition(first + 1, last, first, comp);
+		sort_introsort_loop(cut, last, depth_limit, comp);
+		last = cut;
+	}
+}
+
+template <typename It, typename Compare>
+void sort_unguarded_linear_insert(It last, Compare &comp)
+{
+	auto value = std::move(*last);
+	It next = last;
+	--next;
+	while (comp(value, *next))
+	{
+		*last = std::move(*next);
+		last = next;
+		--next;
+	}
+	*last = std::move(value);
+}
+
+template <typename It, typename Compare>
+void sort_insertion_sort(It first, It last, Compare &comp)
+{
+	if (first == last)
+		return;
+	for (It i = first + 1; i != last; ++i)
+	{
+		if (comp(*i, *first))
+		{
+			auto value = std::move(*i);
+			std::move_backward(first, i, i + 1);
+			*first = std::move(value);
+		}
+		else
+			sort_unguarded_linear_insert(i, comp);
+	}
+}
+
+template <typename It, typename Compare>
+void sort_final_insertion_sort(It first, It last, Compare &comp)
+{
+	if (last - first > ptrdiff_t(threshold))
+	{
+		sort_insertion_sort(first, first + ptrdiff_t(threshold), comp);
+		for (It i = first + ptrdiff_t(threshold); i != last; ++i)
+			sort_unguarded_linear_insert(i, comp);
+	}
+	else
+		sort_insertion_sort(first, last, comp);
+}
+
+inline int floor_log2(size_t n)
+{
+	int result = 0;
+	while (n >>= 1)
+		result++;
+	return result;
+}
+}
+
+template <typename It, typename Compare>
+void portable_sort(It first, It last, Compare comp)
+{
+	if (first == last)
+		return;
+	portable_sort_detail::sort_introsort_loop(first, last, portable_sort_detail::floor_log2(size_t(last - first)) * 2, comp);
+	portable_sort_detail::sort_final_insertion_sort(first, last, comp);
+}
+
+template <typename It>
+void portable_sort(It first, It last)
+{
+	portable_sort(first, last, [](const auto &a, const auto &b) { return a < b; });
+}
+}

